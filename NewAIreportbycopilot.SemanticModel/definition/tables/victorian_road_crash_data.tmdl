table victorian_road_crash_data
	lineageTag: 7b6398d0-4458-4abe-8abf-bc99d2b2b612

	measure Crashes = COUNTROWS(victorian_road_crash_data)
		formatString: #,0
		lineageTag: b8d3df22-06ac-43c2-8cb4-1699c1c0e45a

	measure Deaths = SUM(victorian_road_crash_data[FATALITY])
		formatString: #,0
		lineageTag: a766a516-d04b-49d5-bfde-21d92e5b191d

	measure 'Serious Injuries' = SUM(victorian_road_crash_data[SERIOUSINJURY])
		formatString: #,0
		lineageTag: 3a016272-4d12-4dc0-b080-1b3dcf256f45

	measure 'Deaths per 1,000 Crashes' = DIVIDE([Deaths], [Crashes]) * 1000
		formatString: 0.0
		lineageTag: 5852da54-de6f-49dd-904f-248dc4118871

	measure 'Crashes vs Prior Year' = ```
			VAR y = YEAR(MAX(victorian_road_crash_data[ACCIDENT_DATE]))
			VAR cur = CALCULATE([Crashes], REMOVEFILTERS('LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'), 'LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'[Year] = y)
			VAR prior = CALCULATE([Crashes], REMOVEFILTERS('LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'), 'LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'[Year] = y - 1)
			RETURN
			    IF(
			        ISBLANK(y), BLANK(),
			        IF(ISBLANK(prior), y & ": no prior year", y & ": " & FORMAT(cur - prior, "+#,0;-#,0;0") & " vs " & (y - 1))
			    )
			```
		lineageTag: 7c0cd964-6fd5-4bd1-803f-644259576a93

	measure 'Deaths vs Prior Year' = ```
			VAR y = YEAR(MAX(victorian_road_crash_data[ACCIDENT_DATE]))
			VAR cur = CALCULATE([Deaths], REMOVEFILTERS('LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'), 'LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'[Year] = y)
			VAR prior = CALCULATE([Deaths], REMOVEFILTERS('LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'), 'LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'[Year] = y - 1)
			RETURN
			    IF(
			        ISBLANK(y), BLANK(),
			        IF(ISBLANK(prior), y & ": no prior year", y & ": " & FORMAT(cur - prior, "+#,0;-#,0;0") & " vs " & (y - 1))
			    )
			```
		lineageTag: 3664b18a-6f31-4a6c-99b0-32be73422266

	measure 'Serious Injuries vs Prior Year' = ```
			VAR y = YEAR(MAX(victorian_road_crash_data[ACCIDENT_DATE]))
			VAR cur = CALCULATE([Serious Injuries], REMOVEFILTERS('LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'), 'LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'[Year] = y)
			VAR prior = CALCULATE([Serious Injuries], REMOVEFILTERS('LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'), 'LocalDateTable_54414416-33de-4d1f-a775-2118f4f740e5'[Year] = y - 1)
			RETURN
			    IF(
			        ISBLANK(y), BLANK(),
			        IF(ISBLANK(prior), y & ": no prior year", y & ": " & FORMAT(cur - prior, "+#,0;-#,0;0") & " vs " & (y - 1))
			    )
			```
		lineageTag: 74310e92-219e-4773-a27b-3fe1457aed7d

